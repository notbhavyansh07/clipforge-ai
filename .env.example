# ClipForge AI - Configuration

# App
PROJECT_NAME="ClipForge AI"
API_V1_STR="/api/v1"

# Database & Celery
DATABASE_URL="sqlite:///./clipforge.db"
REDIS_URL="redis://localhost:6379/0"
CELERY_ALWAYS_EAGER=False

# Media directories
UPLOAD_DIR="uploads"
CLIPS_DIR="clips"
TEMP_DIR="temp"

# FFmpeg paths (set full path if not in system PATH)
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# AI / LLM Configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Whisper
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Virality Rubric Weights (Sums to 1.0)
WEIGHT_HOOK=0.30
WEIGHT_EMOTION=0.20
WEIGHT_PACING=0.20
WEIGHT_STORY=0.15
WEIGHT_TREND=0.15

# Google OAuth2 & YouTube Data API v3
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/youtube/oauth/callback"

